<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET helper process of ADR-014. No NuGet packages, no Microsoft files. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AlDotNetSidecar</AssemblyName>
    <RootNamespace>AlDotNetSidecar</RootNamespace>
    <!-- ICU globalization as in BC: invariant mode would change comparison and casing results. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <UseAppHost>false</UseAppHost>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- With -p:AlReadyToRun=true the publish compiles the sidecar's own code ahead of time (ReadyToRun) for the SDK's
       portable runtime id, still framework-dependent: each sidecar process then starts without JIT-compiling the dispatch
       code. It needs the runtime pack and the crossgen2 pack from NuGet; the runner falls back to a plain publish when
       they cannot be had. -->
  <PropertyGroup Condition="'$(AlReadyToRun)' == 'true'">
    <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Marshal.cs" />
    <Compile Include="Dispatch.cs" />
    <Compile Include="Resolver.cs" />
  </ItemGroup>
</Project>
